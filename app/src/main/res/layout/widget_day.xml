<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp"
    android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/day_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#655D4D"/>
    <TextView android:id="@+id/day_minutes" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#253B34"/>
</LinearLayout>
