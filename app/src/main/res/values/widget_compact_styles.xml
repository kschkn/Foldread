<resources>
    <style name="WidgetCompact">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:background">@drawable/widget_paper</item>
    </style>
    <style name="WidgetCompactLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#655D4D</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
    <style name="WidgetCompactTitle" parent="WidgetCompactLine">
        <item name="android:layout_height">20dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">#253B34</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">17sp</item>
    </style>
</resources>
